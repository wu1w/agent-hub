{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "plugins": ["@stryker-mutator/tap-runner"],
  "tap": {
    "testFiles": [
      "src/server.test.ts",
      "src/core/runtime-fixes-20260918.test.ts",
      "src/core/module-coverage.test.ts"
    ],
    "nodeArgs": [
      "--import",
      "tsx",
      "--import",
      "{{hookFile}}",
      "--test-reporter=tap",
      "--test-concurrency=1"
    ],
    "forceBail": true
  },
  "mutate": ["src/server.ts"],
  "ignorePatterns": [
    ".agent-hub-data",
    "docs",
    "scripts",
    "reports",
    "*.md",
    "demos",
    "web/brand",
    "web/*.png",
    "web/*.jpg"
  ],
  "disableTypeChecks": "src/**/*.ts",
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/server/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/server/report.json"
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/server/stryker-incremental.json",
  "coverageAnalysis": "perTest",
  "timeoutMS": 20000,
  "timeoutFactor": 1.5,
  "dryRunTimeoutMinutes": 15,
  "concurrency": 4,
  "ignoreStatic": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "clearTextReporter": {
    "allowColor": true,
    "logTests": false,
    "reportMutants": false,
    "skipFull": true
  }
}
